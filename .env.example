# Generated by `vpd env --dotenv`. Only the three required values must be set.

# Required
# MariaDB host name or IP
VP_DB_HOST=
# MariaDB user
VP_DB_USER=
# MariaDB password. VP_DB_PASSWORD_FILE reads it from a file instead (Docker secrets)
VP_DB_PASSWORD=

# Optional: Database
# Database name. It must already exist; the tables are created on first start
#VP_DB_NAME=voip_panel
# MariaDB port
#VP_DB_PORT=3306
# Replaces all VP_DB_* above, e.g. mysql://user:pass@host:3306/voip_panel. VP_DB_URL_FILE also works
#VP_DB_URL=
# disabled, preferred, required, verify_ca or verify_identity
#VP_DB_SSL_MODE=preferred
# Connection pool size
#VP_DB_MAX_CONNECTIONS=10
# Attempts to reach MariaDB at startup before giving up
#VP_DB_CONNECT_RETRIES=60
# Wait between those attempts
#VP_DB_CONNECT_RETRY_SECONDS=2

# Optional: Storage
# Where the Local file storage keeps its data. Mount a volume here
#VP_DATA_DIR=/data
# The storage engine the Local file storage runs. Only change it when running outside the image
#VP_LOCAL_ENGINE=/usr/local/bin/clickhouse
# Port on 127.0.0.1 the Local file storage engine listens on inside the container
#VP_LOCAL_PORT=8124

# Optional: Network
# Address and port for the web UI and API
#VP_LISTEN=0.0.0.0:8080
# Address and port for HEP over UDP. Empty turns it off
#VP_HEP_UDP=0.0.0.0:9060
# Address and port for HEP over TCP. Empty turns it off
#VP_HEP_TCP=0.0.0.0:9060
# Take the client address from X-Forwarded-For. Only behind a proxy you control
#VP_TRUST_PROXY=false

# Optional: First start and secrets
# Name of the first administrator
#VP_ADMIN_USERNAME=admin
# Creates the administrator at startup and skips the first-run screen. VP_ADMIN_PASSWORD_FILE also works
#VP_ADMIN_PASSWORD=
# If set, the first-run screen asks for this token. Use it when the port is reachable by others before setup
#VP_SETUP_TOKEN=
# Encrypts the ClickHouse passwords saved from the Storage page. Keep it stable: changing it makes saved passwords unreadable
#VP_SECRET_KEY=

# Optional: Logging
# trace, debug, info, warn or error
#VP_LOG_LEVEL=info
# text or json
#VP_LOG_FORMAT=text

# Optional: Branding
# Application name. Shown in the sidebar, the login page and the browser tab.
#VP_APP_NAME=sip-source
# Accent color. CSS color for buttons and highlights, e.g. #2a78d6. Empty keeps the default.
#VP_ACCENT_COLOR=
# Default theme. Used until a user picks their own.
#VP_DEFAULT_THEME=system
# Login message. Text shown under the sign-in form.
#VP_LOGIN_MESSAGE=
# Banner. One line shown at the top of every page, e.g. Staging system.
#VP_BANNER_TEXT=

# Optional: Time
# Default time zone. IANA name. Users can override it in their preferences.
#VP_DEFAULT_TZ=Asia/Baghdad
# Time zones offered. Comma-separated list for the time picker.
#VP_TIME_ZONES=Asia/Baghdad,UTC,Europe/London,Asia/Dubai

# Optional: Dashboards
# Home dashboard. UID of the dashboard shown on the Home page.
#VP_HOME_DASHBOARD=overview
# Default time range. Used when a dashboard or URL does not set one, e.g. now-1h.
#VP_DEFAULT_RANGE=now-6h
# Default auto refresh (s). 0 turns it off.
#VP_DEFAULT_REFRESH_SECONDS=30
# Link charts on hover. When on, pointing at one chart shows the crosshair on every chart of the dashboard. Users and dashboards can override it.
#VP_SHARED_CROSSHAIR=false
# Max points per chart. Upper limit for automatic bucket sizes.
#VP_CHART_MAX_POINTS=1500
# Max series per chart. Extra values fold into "other". Colors stay distinct up to 8.
#VP_CHART_TOP_SERIES=8
# Settle window (s). Newer buckets are drawn dashed or hatched.
#VP_SETTLE_WINDOW_SECONDS=60
# Versions kept per dashboard. Older versions are removed when a dashboard is saved.
#VP_DASHBOARD_VERSIONS_KEEP=20

# Optional: Search
# Default search range. Used when no time range is given.
#VP_SEARCH_DEFAULT_RANGE=now-24h
# Rows per page. Default number of rows in the results table.
#VP_SEARCH_PAGE_SIZE=100
# Max rows per page. Upper limit for one results page.
#VP_SEARCH_MAX_PAGE_SIZE=500
# Values per filter. How many values each filter list shows.
#VP_SEARCH_FACET_SIZE=12
# CSV export limit. Maximum rows in one export.
#VP_EXPORT_MAX_ROWS=100000

# Optional: Live capture
# Enable live capture. Off by default so it uses no resources. Even when on, a stream only runs while someone has pressed Start.
#VP_LIVE_ENABLED=false
# Max concurrent streams. Further viewers get an error.
#VP_LIVE_MAX_SESSIONS=20
# Stop stream after (min). A stream is closed automatically after this long.
#VP_LIVE_IDLE_MINUTES=30
# Update interval (ms). How often a stream sends new messages.
#VP_LIVE_TICK_MS=1000

# Optional: SQL
# Enable SQL. Turns the workbench and SQL panels on or off for everyone.
#VP_SQL_ENABLED=true
# Query timeout (s). Applied to queries sent to ClickHouse.
#VP_SQL_TIMEOUT_SECONDS=120
# Max result rows. Results are cut off at this size.
#VP_SQL_MAX_ROWS=10000

# Optional: Privacy
# Digits left visible when masked. For users without the Unmask numbers permission.
#VP_MASK_KEEP_DIGITS=4

# Optional: Sessions & passwords
# Idle timeout (min). Sign out after this long with no requests.
#VP_SESSION_IDLE_MINUTES=30
# Absolute timeout (h). Sign out this long after login, regardless of activity.
#VP_SESSION_ABSOLUTE_HOURS=12
# Minimum password length. Applies when a password is set.
#VP_PASSWORD_MIN_LENGTH=12
# Failed logins before lockout. Per account.
#VP_LOGIN_MAX_ATTEMPTS=5
# Lockout duration (min). How long an account stays locked.
#VP_LOGIN_LOCKOUT_MINUTES=15
# Session cookie name. Change it when several instances share a host name.
#VP_COOKIE_NAME=vp_session
# Secure cookie. auto follows the X-Forwarded-Proto header set by a TLS proxy.
#VP_COOKIE_SECURE=auto

# Optional: Audit
# Audit retention (days). Older audit events are deleted daily.
#VP_AUDIT_RETENTION_DAYS=365

# Optional: Capture
# HEP auth key. When set, HEP packets without this key are dropped. Asterisk: capture_password in hep.conf.
#VP_HEP_AUTH_KEY=
# Correlation headers. Comma-separated SIP headers that carry the other leg's Call-ID.
#VP_CORRELATION_HEADERS=X-CID
# Match legs by number and time. Joins two dialogs into one call when no header links them: same capture agent, within 3 s, the second leaves the host the first arrived at, and the last 7 digits of the called number match.
#VP_CORRELATION_HEURISTIC=true
# Call assembly interval (s). How often changed dialogs are turned into call records.
#VP_FINALIZER_SECONDS=5
# Close open calls after (h). A call with no signalling for this long is closed as timed out.
#VP_CALL_MAX_AGE_HOURS=6
# High PDD threshold (ms). Calls above this get the High post-dial delay finding.
#VP_PDD_WARNING_MS=5000
# High-risk prefixes. Comma-separated normalized number prefixes that raise a toll-fraud finding.
#VP_HIGH_RISK_PREFIXES=

# Optional: Topology
# Carriers. Name=CIDR pairs, comma separated, e.g. CarrierX=203.0.113.0/24,CarrierY=198.51.100.7. Sets call direction and trunk.
#VP_TOPOLOGY_CARRIERS=
# Subscriber groups. Name=CIDR pairs, comma separated, e.g. Baghdad=10.10.0.0/16.
#VP_TOPOLOGY_SUBSCRIBERS=

# Optional: Retention
# SIP messages (days). Applied to ClickHouse at startup and when a storage is selected.
#VP_RETENTION_MESSAGES_DAYS=30
# Registrations (days). Applied to ClickHouse at startup and when a storage is selected.
#VP_RETENTION_REGISTRATIONS_DAYS=30
# RTCP reports (days). Applied to ClickHouse at startup and when a storage is selected.
#VP_RETENTION_QOS_DAYS=7
# Logs (days). Applied to ClickHouse at startup and when a storage is selected.
#VP_RETENTION_LOGS_DAYS=14
# Call records (days). Applied to ClickHouse at startup and when a storage is selected.
#VP_RETENTION_CALLS_DAYS=365
# Capture metrics (days). Applied to ClickHouse at startup and when a storage is selected.
#VP_RETENTION_METRICS_DAYS=90

# Copy to .env next to docker-compose.yml and fill in your own values.

# Required
MARIADB_ROOT_PASSWORD=
VP_DB_PASSWORD=

# Recommended: encrypts the ClickHouse password saved from the Storage page.
# Keep it stable; changing it makes the saved password unreadable.
VP_SECRET_KEY=

# Optional: the first-run screen asks for this before creating the admin.
VP_SETUP_TOKEN=

# Optional: ports on the host
# VP_PORT=8080
# VP_HEP_PORT=9060
